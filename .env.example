# ───────── عمومی ─────────
NODE_ENV=development
PORT=3000
# آدرس عمومی سایت (برای Callback درگاه و بررسی Origin). در production حتماً https باشد.
APP_ORIGIN=http://localhost:3000

# ───────── پایگاه داده ─────────
# production: PostgreSQL (مثلاً postgres://user:pass@host:5432/academy)
# development: اگر خالی باشد از SQLite داخلی Node (فایل data/dev.sqlite) استفاده می‌شود.
DATABASE_URL=
DATABASE_SSL=false

# ───────── امنیت ─────────
# رشته تصادفی حداقل ۳۲ کاراکتری: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
SESSION_DAYS=30

# ───────── پیامک (OTP) ─────────
# kavenegar | smsir | console (console فقط در development مجاز است و کد را در لاگ سرور چاپ می‌کند)
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=verify
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=

# ───────── درگاه پرداخت زرین‌پال ─────────
ZARINPAL_MERCHANT_ID=
# true = محیط sandbox رسمی زرین‌پال (برای تست قبل از دریافت مرچنت واقعی)
ZARINPAL_SANDBOX=true

# ───────── ذخیره‌سازی ویدیو ─────────
# local = پوشه خصوصی روی سرور (برای توسعه/سرور تک) | s3 = فضای ابری S3-compatible (ابرآروان، لیارا، MinIO، AWS)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage-private
MAX_VIDEO_SIZE_MB=4096
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# true = آدرس‌دهی path-style (ابرآروان/MinIO)، false = virtual-host (AWS)
S3_FORCE_PATH_STYLE=true
# مدت اعتبار لینک امضاشده پخش ویدیو (ثانیه)
VIDEO_URL_TTL=7200

# ───────── دستیار هوش مصنوعی (اختیاری) ─────────
# هر API سازگار با OpenAI Chat Completions. اگر خالی باشد، موتور محاسباتی محلی پاسخ می‌دهد.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
